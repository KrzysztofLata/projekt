<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
 x:Class="projekt.dokonaj_rejestru"
 xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"             
         >
    <Grid>


        <Grid BackgroundColor="#1B1B1B" ColumnDefinitions="*, *, *" RowDefinitions="*, *,*">

            <shapes:Ellipse
              WidthRequest="190"
              HeightRequest="190"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              Margin="-45,-40,0,0"
              Fill="#665A4A"
              Opacity="0.45" />

            <shapes:Ellipse
              WidthRequest="220"
              HeightRequest="220"
              HorizontalOptions="Center"
              VerticalOptions="Start"
              Margin="0,-100,0,0"
              Fill="#425C59"
              Opacity="0.65" />

            <shapes:Ellipse
              WidthRequest="180"
              HeightRequest="180"
              HorizontalOptions="End"
              VerticalOptions="Start"
              Margin="0,-30,-60,0"
              Fill="#694F62"
              Opacity="0.55" />

            <shapes:Ellipse
              WidthRequest="170"
              HeightRequest="170"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="-40,0,0,0"
              Fill="#586049"
              Opacity="0.50" Grid.Column="2"
Grid.Row="2"/>
            <shapes:Ellipse
              WidthRequest="170"
              HeightRequest="170"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="-40,0,0,0"
              Fill="#586049"
              Opacity="0.50" Grid.Column="1"
Grid.Row="2"/>
            <shapes:Ellipse
              WidthRequest="180"
              HeightRequest="180"
              HorizontalOptions="End"
              VerticalOptions="Start"
              Margin="0,-30,-60,0"
              Fill="#694F62"
              Opacity="0.55" />

            <shapes:Ellipse
              WidthRequest="170"
              HeightRequest="170"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="-40,0,0,0"
              Fill="#586049"
              Opacity="0.50" Grid.Column="2"
Grid.Row="2"/>
            <shapes:Ellipse
              WidthRequest="170"
              HeightRequest="170"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="-40,0,0,0"
              Fill="#586049"
              Opacity="0.50" Grid.Column="0"
Grid.Row="2"/>

            <shapes:Ellipse
              WidthRequest="210"
              HeightRequest="210"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Margin="0,-30,0,0"
              Fill="#66525E"
              Opacity="0.40" Grid.Column="0"
Grid.Row="1" />
            <shapes:Ellipse
              WidthRequest="210"
              HeightRequest="210"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Margin="0,-30,0,0"
              Fill="#66525E"
              Opacity="0.40" Grid.Column="2"
Grid.Row="1" />

            <shapes:Ellipse
              WidthRequest="180"
              HeightRequest="180"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,40,-50,0"
              Fill="#4C5749"
              Opacity="0.45"
                Grid.Column="2"
                Grid.Row="1"/>

            <shapes:Ellipse
              WidthRequest="180"
              HeightRequest="180"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,40,-50,0"
              Fill="#4C5749"
              Opacity="0.45"
                Grid.Column="2"
                Grid.Row="0"/>
            <shapes:Ellipse
              WidthRequest="180"
              HeightRequest="180"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,40,-50,0"
              Fill="#4C5749"
              Opacity="0.45"
                Grid.Column="1"
                Grid.Row="0"/>
            <zxing:CameraBarcodeReaderView
                x:Name="cameraView"
                BarcodesDetected="CameraView_BarcodeDetected"
                IsTorchOn="False"
                IsDetecting="True"
                Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            Grid.RowSpan="1"
                      />
        </Grid>


        <Border
          Margin="25,0"
          VerticalOptions="Center"
          BackgroundColor="#242323"
          StrokeThickness="0"
          Padding="0">

            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="3" />
            </Border.StrokeShape>
        </Border>
    </Grid>

</ContentPage>