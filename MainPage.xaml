<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TabletyRejestrApp.MainPage"
             Shell.NavBarIsVisible="False">


    <Grid VerticalOptions="Center" HorizontalOptions="Center">


        <!-- tło, przeniesc do soobnej kontorlki-->
        <Image
        Source="background_maui.jpg"
        Aspect="AspectFill" />

        <!-- delikatne przyciemnienie -->
        <BoxView
        BackgroundColor="#20000000" />

        <!-- gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush
                StartPoint="0,1"
                EndPoint="0,0">

                    <GradientStop
                    Color="#FF000000"
                    Offset="0" />

                    <GradientStop
                    Color="#BB000000"
                    Offset="0.45" />

                    <GradientStop
                    Color="#77000000"
                    Offset="1" />

                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Margin="85" RowDefinitions="auto,.70*,5,25,auto">
            <Button Clicked="OnExit_Clicked"
                    HorizontalOptions="End"
                    Text="Exit"
                    FontAttributes="Bold"
                    FontSize="25"
                    ImageSource="exit.png"
                    ContentLayout="Right,10"
                    HeightRequest="60"
                    WidthRequest="160"
                    Background="Transparent"
                >
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="10,10"
                        Radius="20"
                        Opacity="0.5" />
                </Button.Shadow>
            </Button>

            <HorizontalStackLayout VerticalOptions="Center" Grid.Row="1" HorizontalOptions="Center" Padding="20" Spacing="60">
                <VerticalStackLayout>
                    <Button WidthRequest="200" Padding="35" HeightRequest="200" BackgroundColor="Coral" ImageSource="calendar.png">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Offset="10,10"
                                Radius="20"
                                Opacity="0.5" />
                        </Button.Shadow>
                    </Button>
                    <Label FontAttributes="Bold" HorizontalOptions="Center" Margin="10" TextColor="White" FontSize="25"  Text="Kalendarz"></Label>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Button Clicked="Tablety_Clicked" WidthRequest="200" Padding="35" HeightRequest="200" BackgroundColor="LightPink" ImageSource="tablet.png">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Offset="10,10"
                                Radius="20"
                                Opacity="0.5" />
                        </Button.Shadow>
                    </Button>
                    <Label FontAttributes="Bold" HorizontalOptions="Center" Margin="10" TextColor="White" FontSize="25"  Text="Tablety"></Label>
                </VerticalStackLayout>

                <VerticalStackLayout Margin="60,0,0,0">
                    <Button Clicked="DokonajRejestru_Clicked" WidthRequest="200" Padding="35" HeightRequest="200" BackgroundColor="LightCyan" ImageSource="camera.png">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Offset="10,10"
                                Radius="20"
                                Opacity="0.5" />
                        </Button.Shadow>
                    </Button>
                    <Label FontAttributes="Bold" HorizontalOptions="Center" Margin="10" TextColor="White" FontSize="25"  Text="Dokonaj rejestru"></Label>
                </VerticalStackLayout>

            </HorizontalStackLayout>

            <Rectangle BackgroundColor="White" Grid.Row="2"></Rectangle>

            <HorizontalStackLayout Grid.Row="4" HorizontalOptions="End" Spacing="40">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="people.png" HeightRequest="30"></Image>
                    <Button  Text="Baza uczniów" BackgroundColor="White" Padding="30, 10" FontAttributes="Bold" FontSize="15" TextColor="Black"></Button>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Image Source="settings.png" HeightRequest="30"></Image>
                    <Button  Text="Ustawienia" BackgroundColor="White" Padding="30, 10" FontAttributes="Bold" FontSize="15" TextColor="Black"></Button>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
